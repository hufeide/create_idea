{"step_index":182,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-24T08:14:00Z","content":"Created At: 2026-10-24T16:14:00+08:00\nCompleted At: 2026-10-24T16:14:00+08:00\nFile Path: `file:///home/administator/workspace/create_idea/worktrees/e1/e3/src/weather-card.js`\nTotal Lines: 285\nTotal Bytes: 11930\nShowing lines 1 to 285\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * weather-card.js — dependency-free module that renders weather data into\n3:  * a friendly card UI.\n4:  *\n5:  * Public API\n6:  * ----------\n7:  *  renderWeatherCard(city)              -> string   (HTML for one card)\n8:  *  renderWeatherGrid(cities)            -> string   (HTML for a grid of cards)\n9:  *  renderWeatherGridToElement(el, cities) -> Element|null\n10:  *  injectStyles()                       -> void     (injects the card CSS, browser only)\n11:  *\n12:  *  Data normalization (data-fetching egg → card schema)\n13:  *  ---------------------------------------------------\n14:  *  mapShanghaiData(raw)                 -> object  (Open-Meteo-style raw data → card object,\n15:  *                                                   includes a `daily` array for the 3-day trend)\n16:  *\n17:  *  `city` shape (missing fields are gracefully omitted):\n18:  *   {\n19:  *     city: 'Tokyo',                     // required\n20:  *     country: 'JP',                     // optional\n21:  *     temp: 22,                          // required\n22:  *     unit: '°C',                        // optional ('C' | 'F' | '°C' | '°F'), default '°C'\n23:  *     feelsLike: 20,                     // optional\n24:  *     condition: 'partly-cloudy',        // code, icon name, or free text ('light rain'…)\n25:  *     icon: 'cloudy',                    // alternative to `condition`\n26:  *     description: 'Mostly sunny',       // optional human-readable description\n27:  *     humidity: 65,                      // optional, %\n28:  *     windKmh: 12,                       // optional\n29:  *     windDirection: 'NW',               // optional\n30:  *     high: 25, low: 17,                 // optional\n31:  *     time: '14:18',                     // optional display time\n32:  *     hourly: [{ time: '15:00', temp: 22, condition: 'cloudy' }]\n33:  *     daily:  [{ date, label, condition, description, high, low }]   // optional, 3-day trend\n34:  *   }\n35:  */\n36: \n37: const ICONS = {\n38:   clear:           { emoji: '☀️', label: 'Sunny' },\n39:   'clear-night':   { emoji: '🌙', label: 'Clear night' },\n40:   'partly-cloudy': { emoji: '🌤️', label: 'Partly cloudy' },\n41:   cloudy:          { emoji: '☁️', label: 'Cloudy' },\n42:   overcast:        { emoji: '☁️', label: 'Overcast' },\n43:   fog:             { emoji: '🌫️', label: 'Foggy' },\n44:   drizzle:         { emoji: '🌦️', label: 'Drizzle' },\n45:   rain:            { emoji: '🌧️', label: 'Rainy' },\n46:   'heavy-rain':    { emoji: '🌧️', label: 'Heavy rain' },\n47:   thunderstorm:    { emoji: '⛈️', label: 'Thunderstorm' },\n48:   snow:            { emoji: '❄️', label: 'Snowy' },\n49:   sleet:           { emoji: '🌨️', label: 'Sleet' },\n50: };\n51: \n52: const GRADIENTS = {\n53:   clear:           'linear-gradient(135deg, #ffd166, #f77f00)',\n54:   'clear-night':   'linear-gradient(135deg, #1e3a5f, #0d1b2a)',\n55:   'partly-cloudy': 'linear-gradient(135deg, #90caf9, #4fc3f7)',\n56:   cloudy:          'linear-gradient(135deg, #b0bec5, #78909c)',\n57:   overcast:        'linear-gradient(135deg, #90a4ae, #546e7a)',\n58:   fog:             'linear-gradient(135deg, #eceff1, #b0bec5)',\n59:   drizzle:         'linear-gradient(135deg, #78909c, #546e7a)',\n60:   rain:            'linear-gradient(135deg, #546e7a, #263238)',\n61:   'heavy-rain':    'linear-gradient(135deg, #37474f, #1a2228)',\n62:   thunderstorm:    'linear-gradient(135deg, #455a64, #1a2228)',\n63:   snow:            'linear-gradient(135deg, #e0f7fa, #b2dfdb)',\n64:   sleet:           'linear-gradient(135deg, #cfd8dc, #90a4ae)',\n65: };\n66: \n67: const LIGHT = ['clear', 'partly-cloudy', 'cloudy', 'overcast', 'fog', 'drizzle', 'snow', 'sleet'];\n68: \n69: const FALLBACK = { emoji: '☁️', label: 'Weather' };\n70: \n71: const KEYWORD_RULES = [\n72:   { re: /thunder|lightning|storm/, name: { code: 'thunderstorm', emoji: '⛈️', label: 'Thunderstorm' } },\n73:   { re: /snow|sleet/,              name: { code: 'snow', ...ICONS.snow } },\n74:   { re: /rain|drizzle/,           name: { code: 'rain', ...ICONS.rain } },\n75:   { re: /fog|mist|haze/,          name: { code: 'fog', ...ICONS.fog } },\n76:   { re: /cloud|overcast/,         name: { code: 'cloudy', ...ICONS.cloudy } },\n77:   { re: /clear|sunny|sun/,        name: { code: 'clear', ...ICONS.clear } },\n78: ];\n79: \n80: /**\n81:  * Open-Meteo WMO weather codes → card condition codes, used to normalize\n82:  * the structured data returned by the data-fetching egg.\n83:  */\n84: const WMO_CODE_MAP = {\n85:   0: 'clear', 1: 'partly-cloudy', 2: 'partly-cloudy', 3: 'overcast',\n86:   45: 'fog', 48: 'fog',\n87:   51: 'drizzle', 53: 'drizzle', 55: 'drizzle',\n88:   56: 'sleet', 57: 'sleet',\n89:   61: 'rain', 63: 'rain', 65: 'rain',\n90:   66: 'sleet', 67: 'sleet',\n91:   71: 'snow', 73: 'snow', 75: 'snow', 77: 'snow',\n92:   80: 'rain', 81: 'rain', 82: 'heavy-rain',\n93:   85: 'snow', 86: 'snow',\n94:   95: 'thunderstorm', 96: 'thunderstorm', 99: 'thunderstorm',\n95: };\n96: \n97: /** Chinese labels for WMO codes (used by the Shanghai card). */\n98: const WMO_ZH = {\n99:   0: '晴', 1: '晴', 2: '少云', 3: '多云', 45: '雾', 48: '雾',\n100:   51: '毛毛雨', 53: '毛毛雨', 55: '毛毛雨', 56: '冻雨', 57: '冻雨',\n101:   61: '小雨', 63: '中雨', 65: '大雨', 66: '冻雨', 67: '冻雨',\n102:   71: '小雪', 73: '中雪', 75: '大雪', 77: '雪粒',\n103:   80: '阵雨', 81: '中阵雨', 82: '大雨', 85: '小雪花', 86: '大雪花',\n104:   95: '雷暴', 96: '雷暴', 99: '雷暴',\n105: };\n106: \n107: function codeToCondition(code) {\n108:   const key = WMO_CODE_MAP[code];\n109:   return key && ICONS[key] ? { code: key, ...ICONS[key] } : null;\n110: }\n111: \n112: function round1(n) {\n113:   return Math.round(n * 10) / 10;\n114: }\n115: \n116: function extractTime(observedAt) {\n117:   const m = String(observedAt ?? '').match(/T(\\d{2}:\\d{2})/);\n118:   return m ? m[1] : null;\n119: }\n120: \n121: const WEEKDAY_ZH = ['一', '二', '三', '四', '五', '六', '日'];\n122: \n123: function weekdayOf(dateStr) {\n124:   const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(dateStr ?? ''));\n125:   if (!m) return '';\n126:   return WEEKDAY_ZH[new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])).getDay()];\n127: }\n128: function esc(v) {\n129:   return String(v ?? '').replace(/[&<>\"']/g, (ch) => ({\n130:     '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;'\n131:   }[ch]));\n132: }\n133: \n134: export function unitOf(city) {\n135:   const u = String(city.unit ?? city.tempUnit ?? 'C').replace(/°/g, '').toUpperCase();\n136:   return u === 'F' ? '°F' : '°C';\n137: }\n138: \n139: export function resolveCondition(city) {\n140:   const raw = String(\n141:     city.condition ?? city.icon ?? city.weather?.condition ?? city.weather?.icon ?? 'clear'\n142:   ).toLowerCase().replace(/\\s+/g, '-');\n143:   if (ICONS[raw]) return { code: raw, ...ICONS[raw] };\n144:   for (const rule of KEYWORD_RULES) {\n145:     if (rule.re.test(raw)) return { code: rule.name.code, ...rule.name };\n146:   }\n147:   return { code: 'cloudy', ...FALLBACK };\n148: }\n149: \n150: function themeFor(code) {\n151:   const light = LIGHT.includes(code);\n152:   return {\n153:     text: light ? '#1a202c' : '#f7fafc',\n154:     chip: light ? 'rgba(255, 255, 255, 0.30)' : 'rgba(255, 255, 255, 0.14)',\n155:   };\n156: }\n157: \n158: function statRows(city) {\n159:   const rows = [\n160:     { label: 'Feels like', value: city.feelsLike != null ? `${esc(city.feelsLike)}${unitOf(city)}` : null },\n161:     { label: 'Humidity',   value: city.humidity   != null ? `${esc(city.humidity)}%` : null },\n162:     { label: 'Wind',       value: city.windKmh    != null\n163:       ? `${esc(city.windKmh)} km/h${city.windDirection ? ' ' + esc(city.windDirection) : ''}`\n164:       : null },\n165:     { label: 'Today',      value: city.high != null && city.low != null\n166:       ? `${esc(city.high)}° / ${esc(city.low)}°` : null },\n167:   ];\n168:   return rows\n169:     .filter((r) => r.value != null)\n170:     .map((r) => `<div class=\"wc-stat\"><span class=\"wc-stat-label\">${r.label}</span><span class=\"wc-stat-value\">${r.value}</span></div>`)\n171:     .join('');\n172: }\n173: \n174: function hourlyRow(hourly, unit) {\n175:   if (!Array.isArray(hourly) || hourly.length === 0) return '';\n176:   const items = hourly\n177:     .map((h) => {\n178:       const cond = resolveCondition(h);\n179:       const t = h.temp != null ? `${esc(h.temp)}${unit}` : '';\n180:       return `<div class=\"wc-hour\"><span class=\"wc-hour-time\">${esc(h.time ?? '')}</span><span class=\"wc-hour-icon\" aria-hidden=\"true\">${cond.emoji}</span><span class=\"wc-hour-temp\">${t}</span></div>`;\n181:     })\n182:     .join('');\n183:   return `<div class=\"wc-hourly\" aria-label=\"Hourly forecast\">${items}</div>`;\n184: }\n185: \n186: export function renderWeatherCard(city) {\n187:   const unit = unitOf(city);\n188:   const cond = resolveCondition(city);\n189:   const label = esc(city.description ?? cond.label);\n190:   const theme = themeFor(cond.code);\n191:   const gradient = GRADIENTS[cond.code] ?? GRADIENTS.cloudy;\n192: \n193:   const sub = city.country != null\n194:     ? `<span class=\"wc-sub\">${esc(city.country)}</span>`\n195:     : '';\n196:   const time = city.time != null ? `<span class=\"wc-time\">${esc(city.time)}</span>` : '';\n197: \n198:   const header = `<div class=\"wc-header\"><div class=\"wc-location\"><span class=\"wc-city\">${esc(city.city)}</span>${sub}</div>${time}</div>`;\n199: \n200:   const main = `<div class=\"wc-main\"><span class=\"wc-icon\" aria-hidden=\"true\">${cond.emoji}</span><div class=\"wc-temp\"><span class=\"wc-temp-value\">${esc(city.temp ?? '–')}</span><span class=\"wc-temp-unit\">${unit}</span></div><p class=\"wc-condition\">${label}</p></div>`;\n201: \n202:   const stats = statRows(city);\n203:   const hourlyHtml = hourlyRow(city.hourly, unit);\n204: \n205:   return `<article class=\"wc\" style=\"--wc-bg:${gradient}; --wc-text:${theme.text}; --wc-chip:${theme.chip}\">${header}${main}${stats ? `<div class=\"wc-stats\">${stats}</div>` : ''}${hourlyHtml}</article>`;\n206: }\n207: \n208: export function renderWeatherGrid(cities) {\n209:   const list = Array.isArray(cities) ? cities : [cities];\n210:   return `<div class=\"wc-grid\" role=\"list\">${list.map(renderWeatherCard).join('')}</div>`;\n211: }\n212: \n213: export function renderWeatherGridToElement(container, cities) {\n214:   injectStyles();\n215:   if (container) container.innerHTML = renderWeatherGrid(cities);\n216:   return container;\n217: }\n218: \n219: export function injectStyles() {\n220:   if (typeof document === 'undefined') return;\n221:   if (document.getElementById('weather-card-style')) return;\n222:   const style = document.createElement('style');\n223:   style.id = 'weather-card-style';\n224:   style.textContent = CARD_CSS;\n225:   document.head.appendChild(style);\n226: }\n227: \n228: const CARD_CSS = `\n229: .wc-grid {\n230:   display: grid;\n231:   grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n232:   gap: 16px;\n233: }\n234: .wc {\n235:   position: relative;\n236:   border-radius: 20px;\n237:   background: var(--wc-bg);\n238:   color: var(--wc-text, #1a202c);\n239:   padding: 16px 16px 14px;\n240:   box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);\n241:   transition: transform 0.2s ease, box-shadow 0.2s ease;\n242: }\n243: .wc:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22); }\n244: .wc-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }\n245: .wc-location { display: flex; flex-direction: column; gap: 2px; }\n246: .wc-city { font-size: 1.05rem; font-weight: 700; }\n247: .wc-sub { font-size: 0.8rem; opacity: 0.75; }\n248: .wc-time { font-size: 0.8rem; opacity: 0.8; white-space: nowrap; }\n249: .wc-main { display: flex; align-items: center; gap: 14px; margin: 10px 0 14px; }\n250: .wc-icon { font-size: 3rem; line-height: 1; }\n251: .wc-temp { font-size: 2.9rem; font-weight: 800; line-height: 1; }\n252: .wc-temp-unit { font-size: 1.05rem; font-weight: 600; opacity: 0.85; margin-left: 2px; }\n253: .wc-condition { margin: 0; font-size: 0.95rem; opacity: 0.9; }\n254: .wc-stats {\n255:   display: grid;\n256:   grid-template-columns: repeat(2, 1fr);\n257:   gap: 10px;\n258:   padding: 10px;\n259:   border-radius: 12px;\n260:   background: var(--wc-chip);\n261: }\n262: .wc-stat { display: flex; flex-direction: column; gap: 2px; }\n263: .wc-stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8; }\n264: .wc-stat-value { font-size: 0.95rem; font-weight: 700; }\n265: .wc-hourly { display: flex; gap: 6px; margin-top: 12px; overflow-x: auto; }\n266: .wc-hour {\n267:   flex: 1;\n268:   min-width: 54px;\n269:   text-align: center;\n270:   border-radius: 10px;\n271:   padding: 6px 4px;\n272:   background: var(--wc-chip);\n273:   font-size: 0.78rem;\n274: }\n275: .wc-hour-time { display: block; opacity: 0.8; }\n276: .wc-hour-icon { display: block; font-size: 1.15rem; margin: 2px 0; }\n277: .wc-hour-temp { display: block; font-weight: 700; }\n278: @media (prefers-reduced-motion: reduce) { .wc { transition: none; } }\n279: @media (max-width: 420px) {\n280:   .wc-grid { grid-template-columns: 1fr; }\n281:   .wc-temp { font-size: 2.4rem; }\n282: }\n283: // Module loaded successfully\n284: console.log('weather-card module loaded');\n285: \nThe above content shows the entire, complete file contents of the requested file.\n"}
