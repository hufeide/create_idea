: '雷暴', 96: '雷暴', 99: '雷暴',\n105: };\n106: \n107: function codeToCondition(code) {\n108:   const key = WMO_CODE_MAP[code];\n109:   return key && ICONS[key] ? { code: key, ...ICONS[key] } : null;\n110: }\n111: \n112: function round1(n) {\n113:   return Math.round(n * 10) / 10;\n114: }\n115: \n116: function extractTime(observedAt) {\n117:   const m = String(observedAt ?? '').match(/T(\\d{2}:\\d{2})/);\n118:   return m ? m[1] : null;\n119: }\n120: \n121: const WEEKDAY_ZH = ['一', '二', '三', '四', '五', '六', '日'];\n122: \n123: function weekdayOf(dateStr) {\n124:   const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(dateStr ?? ''));\n125:   if (!m) return '';\n126:   return WEEKDAY_ZH[new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])).getDay()];\n127: }\n128: function esc(v) {\n129:   return String(v ?? '').replace(/[&<>\"']/g, (ch) => ({\n130:     '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;'\n131:   }[ch]));\n132: }\n133: \n134: export function unitOf(city) {\n135:   const u = String(city.unit ?? city.tempUnit ?? 'C').replace(/°/g, '').toUpperCase();\n136:   return u === 'F' ? '°F' : '°C';\n137: }\n138: \n139: export function resolveCondition(city) {\n140:   const raw = String(\n141:     city.condition ?? city.icon ?? city.weather?.condition ?? city.weather?.icon ?? 'clear'\n142:   ).toLowerCase().replace(/\\s+/g, '-');\n143:   if (ICONS[raw]) return { code: raw, ...ICONS[raw] };\n144:   for (const rule of KEYWORD_RULES) {\n145:     if (rule.re.test(raw)) return { code: rule.name.code, ...rule.name };\n146:   }\n147:   return { code: 'cloudy', ...FALLBACK };\n148: }\n149: \n150: function themeFor(code) {\n151:   const light = LIGHT.includes(code);\n152:   return {\n153:     text: light ? '#1a202c' : '#f7fafc',\n154:     chip: light ? 'rgba(255, 255, 255, 0.30)' : 'rgba(255, 255, 255, 0.14)',\n155:   };\n156: }\n157: \n158: function statRows(city) {\n159:   const rows = [\n160:     { label: 'Feels like', value: city.feelsLike != null ? `${esc(city.feelsLike)}${unitOf(city)}` : null },\n161:     { label: 'Humidity',   value: city.humidity   != null ? `${esc(city.humidity)}%` : null },\n162:     { label: 'Wind',       value: city.windKmh    != null\n163:       ? `${esc(city.windKmh)} km/h${city.windDirection ? ' ' + esc(city.windDirection) : ''}`\n164:       : null },\n165:     { label: 'Today',      value: city.high != null && city.low != null\n166:       ? `${esc(city.high)}° / ${esc(city.low)}°` : null },\n167:   ];\n168:   return rows\n169:     .filter((r) => r.value != null)\n170:     .map((r) => `<div class=\"wc-stat\"><span class=\"wc-stat-label\">${r.label}</span><span class=\"wc-stat-value\">${r.value}</span></div>`)\n171:     .join('');\n172: }\n173: \n174: function hourlyRow(hourly, unit) {\n175:   if (!Array.isArray(hourly) || hourly.length === 0) return '';\n176:   const items = hourly\n177:     .map((h) => {\n178:       const cond = resolveCondition(h);\n179:       const t = h.temp != null ? `${esc(h.temp)}${unit}` : '';\n180:       return `<div class=\"wc-hour\"><span class=\"wc-hour-time\">${esc(h.time ?? '')}</span><span class=\"wc-hour-icon\" aria-hidden=\"true\">${cond.emoji}</span><span class=\"wc-hour-temp\">${t}</span></div>`;\n181:     })\n182:     .join('');\n183:   return `<div class=\"wc-hourly\" aria-label=\"Hourly forecast\">${items}</div>`;\n184: }\n185: \n186: export function renderWeatherCard(city) {\n187:   const unit = unitOf(city);\n188:   const cond = resolveCondition(city);\n189:   const label = esc(city.description ?? cond.label);\n190:   const theme = themeFor(cond.code);\n191:   const gradient = GRADIENTS[cond.code] ?? GRADIENTS.cloudy;\n192: \n193:   const sub = city.country != null\n194:     ? `<span class=\"wc-sub\">${esc(city.country)}</span>`\n195:     : '';\n196:   const time = city.time != null ? `<span class=\"wc-time\">${esc(city.time)}</span>` : '';\n197: \n198:   const header = `<div class=\"wc-header\"><div class=\"wc-location\"><span class=\"wc-city\">${esc(city.city)}</span>${sub}</div>${time}</div>`;\n199: \n200:   const main = `<div class=\"wc-main\"><span class=\"wc-icon\" aria-hidden=\"true\">${cond.emoji}</span><div class=\"wc-temp\"><span class=\"wc-temp-value\">${esc(city.temp ?? '–')}</span><span class=\"wc-temp-unit\">${unit}</span></div><p class=\"wc-condition\">${label}</p></div>`;\n201: \n202:   const stats = statRows(city);\n203:   const hourlyHtml = hourlyRow(city.hourly, unit);\n204: \n205:   return `<article class=\"wc\" style=\"--wc-bg:${gradient}; --wc-text:${theme.text}; --wc-chip:${theme.chip}\">${header}${main}${stats ? `<div class=\"wc-stats\">${stats}</div>` : ''}${hourlyHtml}</article>`;\n206: }\n207: \n208: export function renderWeatherGrid(cities) {\n209:   const list = Array.isArray(cities) ? cities : [cities];\n210:   return `<div class=\"wc-grid\" role=\"list\">${list.map(renderWeatherCard).join('')}</div>`;\n211: }\n212: \n213: export function renderWeatherGridToElement(container, cities) {\n214:   injectStyles();\n215:   if (container) container.innerHTML = renderWeatherGrid(cities);\n216:   return container;\n217: }\n218: \n219: export function injectStyles() {\n220:   if (typeof document === 'undefined') return;\n221:   if (document.getElementById('weather-card-style')) return;\n222:   const style = document.createElement('style');\n223:   style.id = 'weather-card-style';\n224:   style.textContent = CARD_CSS;\n225:   document.head.appendChild(style);\n226: }\n227: \n228: const CARD_CSS = `\n229: .wc-grid {\n230:   display: grid;\n231:   grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n232:   gap: 16px;\n233: }\n234: .wc {\n235:   position: relative;\n236:   border-radius: 20px;\n237:   background: var(--wc-bg);\n238:   color: var(--wc-text, #1a202c);\n239:   padding: 16px 16px 14px;\n240:   box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);\n241:   transition: transform 0.2s ease, box-shadow 0.2s ease;\n242: }\n243: .wc:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22); }\n244: .wc-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }\n245: .wc-location { display: flex; flex-direction: column; gap: 2px; }\n246: .wc-city { font-size: 1.05rem; font-weight: 700; }\n247: .wc-sub { font-size: 0.8rem; opacity: 0.75; }\n248: .wc-time { font-size: 0.8rem; opacity: 0.8; white-space: nowrap; }\n249: .wc-main { display: flex; align-items: center; gap: 14px; margin: 10px 0 14px; }\n250: .wc-icon { font-size: 3rem; line-height: 1; }\n251: .wc-temp { font-size: 2.9rem; font-weight: 800; line-height: 1; }\n252: .wc-temp-unit { font-size: 1.05rem; font-weight: 600; opacity: 0.85; margin-left: 2px; }\n253: .wc-condition { margin: 0; font-size: 0.95rem; opacity: 0.9; }\n254: .wc-stats {\n255:   display: grid;\n256:   grid-template-columns: repeat(2, 1fr);\n257:   gap: 10px;\n258:   padding: 10px;\n259:   border-radius: 12px;\n260:   background: var(--wc-chip);\n261: }\n262: .wc-stat { display: flex; flex-direction: column; gap: 2px; }\n263: .wc-stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8; }\n264: .wc-stat-value { font-size: 0.95rem; font-weight: 700; }\n265: .wc-hourly { display: flex; gap: 6px; margin-top: 12px; overflow-x: auto; }\n266: .wc-hour {\n267:   flex: 1;\n268:   min-width: 54px;\n269:   text-align: center;\n270:   border-radius: 10px;\n271:   padding: 6px 4px;\n272:   background: var(--wc-chip);\n273:   font-size: 0.78rem;\n274: }\n275: .wc-hour-time { display: block; opacity: 0.8; }\n276: .wc-hour-icon { display: block; font-size: 1.15rem; margin: 2px 0; }\n277: .wc-hour-temp { display: block; font-weight: 700; }\n278: @media (prefers-reduced-motion: reduce) { .wc { transition: none; } }\n279: @media (max-width: 420px) {\n280:   .wc-grid { grid-template-columns: 1fr; }\n281:   .wc-temp { font-size: 2.4rem; }\n282: }\n283: // Module loaded successfully\n284: console.log('weather-card module loaded');\n285: \nThe above content shows the entire, complete file contents of the requested file.\n"}
