ity)}` : null },\n160:     { label: 'Humidity',   value: city.humidity   != null ? `${esc(city.humidity)}%` : null },\n161:     { label: 'Wind',       value: city.windKmh    != null\n162:       ? `${esc(city.windKmh)} km/h${city.windDirection ? ' ' + esc(city.windDirection) : ''}`\n163:       : null },\n164:     { label: 'Today',      value: city.high != null && city.low != null\n165:       ? `${esc(city.high)}° / ${esc(city.low)}°` : null },\n166:   ];\n167:   return rows\n168:     .filter((r) => r.value != null)\n169:     .map((r) => `<div class=\"wc-stat\"><span class=\"wc-stat-label\">${r.label}</span><span class=\"wc-stat-value\">${r.value}</span></div>`)\n170:     .join('');\n171: }\n172: \n173: function hourlyRow(hourly, unit) {\n174:   if (!Array.isArray(hourly) || hourly.length === 0) return '';\n175:   const items = hourly\n176:     .map((h) => {\n177:       const cond = resolveCondition(h);\n178:       const t = h.temp != null ? `${esc(h.temp)}${unit}` : '';\n179:       return `<div class=\"wc-hour\"><span class=\"wc-hour-time\">${esc(h.time ?? '')}</span><span class=\"wc-hour-icon\" aria-hidden=\"true\">${cond.emoji}</span><span class=\"wc-hour-temp\">${t}</span></div>`;\n180:     })\n181:     .join('');\n182:   return `<div class=\"wc-hourly\" aria-label=\"Hourly forecast\">${items}</div>`;\n183: }\n184: \n185: export function renderWeatherCard(city) {\n186:   const unit = unitOf(city);\n187:   const cond = resolveCondition(city);\n188:   const label = esc(city.description ?? cond.label);\n189:   const theme = themeFor(cond.code);\n190:   const gradient = GRADIENTS[cond.code] ?? GRADIENTS.cloudy;\n191: \n192:   const sub = city.country != null\n193:     ? `<span class=\"wc-sub\">${esc(city.country)}</span>`\n194:     : '';\n195:   const time = city.time != null ? `<span class=\"wc-time\">${esc(city.time)}</span>` : '';\n196: \n197:   const header = `<div class=\"wc-header\"><div class=\"wc-location\"><span class=\"wc-city\">${esc(city.city)}</span>${sub