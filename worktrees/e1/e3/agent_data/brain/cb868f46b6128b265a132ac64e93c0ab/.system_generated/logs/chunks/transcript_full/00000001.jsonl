time: '14:18',                     // optional display time\n27:  *     hourly: [{ time: '15:00', temp: 22, condition: 'cloudy' }]\n28:  *   }\n29:  */\n30: \n31: const ICONS = {\n32:   clear:           { emoji: '☀️', label: 'Sunny' },\n33:   'clear-night':   { emoji: '🌙', label: 'Clear night' },\n34:   'partly-cloudy': { emoji: '🌤️', label: 'Partly cloudy' },\n35:   cloudy:          { emoji: '☁️', label: 'Cloudy' },\n36:   overcast:        { emoji: '☁️', label: 'Overcast' },\n37:   fog:             { emoji: '🌫️', label: 'Foggy' },\n38:   drizzle:         { emoji: '🌦️', label: 'Drizzle' },\n39:   rain:            { emoji: '🌧️', label: 'Rainy' },\n40:   'heavy-rain':    { emoji: '🌧️', label: 'Heavy rain' },\n41:   thunderstorm:    { emoji: '⛈️', label: 'Thunderstorm' },\n42:   snow:            { emoji: '❄️', label: 'Snowy' },\n43:   sleet:           { emoji: '🌨️', label: 'Sleet' },\n44: };\n45: \n46: const GRADIENTS = {\n47:   clear:           'linear-gradient(135deg, #ffd166, #f77f00)',\n48:   'clear-night':   'linear-gradient(135deg, #1e3a5f, #0d1b2a)',\n49:   'partly-cloudy': 'linear-gradient(135deg, #90caf9, #4fc3f7)',\n50:   cloudy:          'linear-gradient(135deg, #b0bec5, #78909c)',\n51:   overcast:        'linear-gradient(135deg, #90a4ae, #546e7a)',\n52:   fog:             'linear-gradient(135deg, #eceff1, #b0bec5)',\n53:   drizzle:         'linear-gradient(135deg, #78909c, #546e7a)',\n54:   rain:            'linear-gradient(135deg, #546e7a, #263238)',\n55:   'heavy-rain':    'linear-gradient(135deg, #37474f, #1a2228)',\n56:   thunderstorm:    'linear-gradient(135deg, #455a64, #1a2228)',\n57:   snow:            'linear-gradient(135deg, #e0f7fa, #b2dfdb)',\n58:   sleet:           'linear-gradient(135deg, #cfd8dc, #90a4ae)',\n59: };\n60: \n61: const LIGHT = ['clear', 'partly-cloudy', 'cloudy', 'overcast', 'fog', 'drizzle', 'snow', 'sleet'];\n62: \n63: const FALLBACK = { emoji: '☁️', label: 'Weather' };\n64: \n65: const KEYWORD_RULES = [\n66:   { re: /thunder|lightning|storm/, name: { code: 'thunderstorm', emoji: '⛈️', label: 'Thunderstorm' } },\n67:   { re: /snow|sleet/,              name: { code: 'snow', ...ICONS.snow } },\n68:   { re: /rain|drizzle/,           name: { code: 'rain', ...ICONS.rain } },\n69:   { re: /fog|mist|haze/,          name: { code: 'fog', ...ICONS.fog } },\n70:   { re: /cloud|overcast/,         name: { code: 'cloudy', ...ICONS.cloudy } },\n71:   { re: /clear|sunny|sun/,        name: { code: 'clear', ...ICONS.clear } },\n72: ];\n73: \n74: function esc(v) {\n75:   return String(v ?? '').replace(/[&<>\"']/g, (ch) => ({\n76:     '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;'\n77:   }[ch]));\n78: }\n79: \n80: export function unitOf(city) {\n81:   const u = String(city.unit ?? city.tempUnit ?? 'C').replace(/°/g, '').toUpperCase();\n82:   return u === 'F' ? '°F' : '°C';\n83: }\n84: \n85: export function resolveCondition(city) {\n86:   const raw = String(\n87:     city.condition ?? city.icon ?? city.weather?.condition ?? city.weather?.icon ?? 'clear'\n88:   ).toLowerCase().replace(/\\s+/g, '-');\n89:   if (ICONS[raw]) return { code: raw, ...ICONS[raw] };\n90:   for (const rule of KEYWORD_RULES) {\n91:     if (rule.re.test(raw)) return { code: rule.name.code, ...rule.name };\n92:   }\n93:   return { code: 'cloudy', ...FALLBACK };\n94: }\n95: \n96: function themeFor(code) {\n97:   const light = LIGHT.includes(code);\n98:   return {\n99:     text: light ? '#1a202c' : '#f7fafc',\n100:     chip: light ? 'rgba(255, 255, 255, 0.30)' : 'rgba(255, 255, 255, 0.14)',\n101:   };\n102: }\n103: \n104: function statRows(city) {\n105:   const rows = [\n106:     { label: 'Feels like', value: city.feelsLike != null ? `${esc(city.feelsLike)}${unitOf(city)}` : null },\n107:     { label: 'Humidity',   value: city.humidity   != null ? `${esc(city.humidity)}%` : null },\n108:     { label: 'Wind',       value: city.windKmh    != null\n109:       ? `${esc(city.windKmh)} km/h${city.windDirection ? ' ' + esc(city.windDirection) : ''}`\n110:       : null },\n111:     { label: 'Today',      value: city.high != null && city.low != null\n112:       ? `${esc(city.high)}° / ${esc(city.low)}°` : null },\n113:   ];\n114:   return rows\n115:     .filter((r) => r.value != null)\n116:     .map((r) => `<div class=\"wc-stat\"><span class=\"wc-stat-label\">${r.label}</span><span class=\"wc-stat-value\">${r.value}</span></div>`)\n117:     .join('');\n118: }\n119: \n120: function hourlyRow(hourly, unit) {\n121:   if (!Array.isArray(hourly) || hourly.length === 0) return '';\n122:   const items = hourly\n123:     .map((h) => {\n124:       const cond = resolveCondition(h);\n125:       const t = h.temp != null ? `${esc(h.temp)}${unit}` : '';\n126:       return `<div class=\"wc-hour\"><span class=\"wc-hour-time\">${esc(h.time ?? '')}</span><span class=\"wc-hour-icon\" aria-hidden=\"true\">${cond.emoji}</span><span class=\"wc-hour-temp\">${t}</span></div>`;\n127:     })\n128:     .join('');\n129:   return `<div class=\"wc-hourly\" aria-label=\"Hourly forecast\">${items}</div>`;\n130: }\n131: \n132: export function renderWeatherCard(city) {\n133:   const unit = unitOf(city);\n134:   const cond = resolveCondition(city);\n135:   const label = esc(city.description ?? cond.label);\n136:   const theme = themeFor(cond.code);\n137:   const gradient = GRADIENTS[cond.code] ?? GRADIENTS.cloudy;\n138: \n139:   const sub = city.country != null\n140:     ? `<span class=\"wc-sub\">${esc(city.country)}</span>`\n141:     : '';\n142:   const time = city.time != null ? `<span class=\"wc-time\">${esc(city.time)}</span>` : '';\n143: \n144:   const header = `<div class=\"wc-header\"><div class=\"wc-location\"><span class=\"wc-city\">${esc(city.city)}</span>${sub}</div>${time}</div>`;\n145: \n146:   const main = `<div class=\"wc-main\"><span class=\"wc-icon\" aria-hidden=\"true\">${cond.emoji}</span><div class=\"wc-temp\"><span class=\"wc-temp-value\">${esc(city.temp ?? '–')}</span><span class=\"wc-temp-unit\">${unit}</span></div><p class=\"wc-condition\">${label}</p></div>`;\n147: \n148:   const stats = statRows(city);\n149:   const hourlyHtml = hourlyRow(city.hourly, unit);\n150: \n151:   return `<article class=\"wc\" style=\"--wc-bg:${gradient}; --wc-text:${theme.text}; --wc-chip:${theme.chip}\">${header}${main}${stats ? `<div class=\"wc-stats\">${stats}</div>` : ''}${hourlyHtml}</article>`;\n152: }\n153: \n154: export function renderWeatherGrid(cities) {\n155:   const list = Array.isArray(cities) ? cities : [cities];\n156:   return `<div class=\"wc-grid\" role=\"list\">${list.map(renderWeatherCard).join('')}</div>`;\n157: }\n158: \n159: export function renderWeatherGridToElement(container, cities) {\n160:   injectStyles();\n161:   if (container) container.innerHTML = renderWeatherGrid(cities);\n162:   return container;\n163: }\n164: \n165: export function injectStyles() {\n166:   if (typeof document === 'undefined') return;\n167:   if (document.getElementById('weather-card-style')) return;\n168:   const style = document.createElement('style');\n169:   style.id = 'weather-card-style';\n170:   style.textContent = CARD_CSS;\n171:   document.head.appendChild(style);\n172: }\n173: \n174: const CARD_CSS = `\n175: .wc-grid {\n176:   display: grid;\n177:   grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n178:   gap: 16px;\n179: }\n180: .wc {\n181:   position: relative;\n182:   border-radius: 20px;\n183:   background: var(--wc-bg);\n184:   color: var(--wc-text, #1a202c);\n185:   padding: 16px 16px 14px;\n186:   box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);\n187:   transition: transform 0.2s ease, box-shadow 0.2s ease;\n188: }\n189: .wc:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22); }\n190: .wc-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }\n191: .wc-location { display: flex; flex-direction: column; gap: 2px; }\n192: .wc-city { font-size: 1.05rem; font-weight: 700; }\n193: .wc-sub { font-size: 0.8rem; opacity: 0.75; }\n194: .wc-time { font-size: 0.8rem; opacity: 0.8; white-space: nowrap; }\n195: .wc-main { display: flex; align-items: center; gap: 14px; margin: 10px 0 14px; }\n196: .wc-icon { font-size: 3rem; line-height: 1; }\n197: .wc-temp { font-size: 2.9rem; font-weight: 800; line-height: 1; }\n198: .wc-temp-unit { font-size: 1.05rem; font-weight: 600; opacity: 0.85; margin-left: 2px; }\n199: .wc-condition { margin: 0; font-size: 0.95rem; opacity: 0.9; }\n200: .wc-stats {\n201:   display: grid;\n202:   grid-template-columns: repeat(2, 1fr);\n203:   gap: 10px;\n204:   padding: 10px;\n205:   border-radius: 12px;\n206:   background: var(--wc-chip);\n207: }\n208: .wc-stat { display: flex; flex-direction: column; gap: 2px; }\n209: .wc-stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8; }\n210: .wc-stat-value { font-size: 0.95rem; font-weight: 700; }\n211: .wc-hourly { display: flex; gap: 6px; margin-top: 12px; overflow-x: auto; }\n212: .wc-hour {\n213:   flex: 1;\n214:   min-width: 54px;\n215:   text-align: center;\n216:   border-radius: 10px;\n217:   padding: 6px 4px;\n218:   background: var(--wc-chip);\n219:   font-size: 0.78rem;\n220: }\n221: .wc-hour-time { display: block; opacity: 0.8; }\n222: .wc-hour-icon { display: block; font-size: 1.15rem; margin: 2px 0; }\n223: .wc-hour-temp { display: block; font-weight: 700; }\n224: @media (prefers-reduced-motion: reduce) { .wc { transition: none; } }\n225: @media (max-width: 420px) {\n226:   .wc-grid { grid-template-columns: 1fr; }\n227:   .wc-temp { font-size: 2.4rem; }\n228: }\n229: `;\n230: \nThe above content shows the entire, complete file contents of the requested file.\n"}
