t');\n41: check(renderWeatherGrid([tokyo]).includes('15:00'), 'hourly forecast renders');\n42: \n43: // condition resolution\n44: check(resolveCondition({ condition: 'clear' }).code === 'clear', 'known code');\n45: check(resolveCondition({ condition: 'heavy-rain' }).code === 'heavy-rain', 'known code 2');\n46: check(resolveCondition({ condition: 'light rain' }).code === 'rain', 'keyword: light rain');\n47: check(resolveCondition({ condition: 'thunderstorm' }).code === 'thunderstorm', 'keyword: thunderstorm');\n48: check(resolveCondition({ condition: 'Foggy' }).code === 'fog', 'keyword: foggy');\n49: check(resolveCondition({ condition: 'sunny' }).code === 'clear', 'keyword: sunny');\n50: check(resolveCondition({ condition: '???' }).code === 'cloudy', 'unknown falls back');\n51: check(resolveCondition({ condition: 'cloudy' }).code === 'cloudy', 'icon name accepted');\n52: \n53: // units\n54: check(unitOf({ temp: 1, unit: 'F' }) === '°F', 'Fahrenheit unit');\n55: check(unitOf({ temp: 1, unit: '°F' }) === '°F', '°F unit');\n56: check(unitOf({ temp: 1 }) === '°C', 'default Celsius');\n57: \n58: // single object accepted for grid\n59: check(renderWeatherGrid(tokyo).includes('Tokyo'), 'grid accepts single object');\n60: \n61: // browser-only APIs are safe in Node\n62: injectStyles();\n63: check(true, 'injectStyles safe in Node (no throw)');\n64: renderWeatherGridToElement(null, [tokyo]);\n65: check(true, 'gridToElement safe with null container in Node (no throw)');\n66: \n67: // escaping\n68: const xss = { city: '<script>alert(1)</script>', temp: 1 };\n69: const out = renderWeatherCard(xss);\n70: check(out.includes('&lt;script&gt;'), 'HTML is escaped');\n71: check(!out.includes('<script>alert(1)</script>'), 'no raw XSS payload');\n72: \n73: if (failures > 0) {\n74:   console.error(`\\n${failures} failure(s)`);\n75:   process.exit(1);\n76: }\n77: console.log('\\nall tests passed');\n78: \nThe above content shows the entire, complete file contents of the requested file.\n"}
