nderstorm:    'linear-gradient(135deg, #455a64, #1a2228)',\n63:   snow:            'linear-gradient(135deg, #e0f7fa, #b2dfdb)',\n64:   sleet:           'linear-gradient(135deg, #cfd8dc, #90a4ae)',\n65: };\n66: \n67: const LIGHT = ['clear', 'partly-cloudy', 'cloudy', 'overcast', 'fog', 'drizzle', 'snow', 'sleet'];\n68: \n69: const FALLBACK = { emoji: '☁️', label: 'Weather' };\n70: \n71: const KEYWORD_RULES = [\n72:   { re: /thunder|lightning|storm/, name: { code: 'thunderstorm', emoji: '⛈️', label: 'Thunderstorm' } },\n73:   { re: /snow|sleet/,              name: { code: 'snow', ...ICONS.snow } },\n74:   { re: /rain|drizzle/,           name: { code: 'rain', ...ICONS.rain } },\n75:   { re: /fog|mist|haze/,          name: { code: 'fog', ...ICONS.fog } },\n76:   { re: /cloud|overcast/,         name: { code: 'cloudy', ...ICONS.cloudy } },\n77:   { re: /clear|sunny|sun/,        name: { code: 'clear', ...ICONS.clear } },\n78: ];\n79: \n80: /**\n81:  * Open-Meteo WMO weather codes → card condition codes, used to normalize\n82:  * the structured data returned by the data-fetching egg.\n83:  */\n84: const WMO_CODE_MAP = {\n85:   0: 'clear', 1: 'partly-cloudy', 2: 'partly-cloudy', 3: 'overcast',\n86:   45: 'fog', 48: 'fog',\n87:   51: 'drizzle', 53: 'drizzle', 55: 'drizzle',\n88:   56: 'sleet', 57: 'sleet',\n89:   61: 'rain', 63: 'rain', 65: 'rain',\n90:   66: 'sleet', 67: 'sleet',\n91:   71: 'snow', 73: 'snow', 75: 'snow', 77: 'snow',\n92:   80: 'rain', 81: 'rain', 82: 'heavy-rain',\n93:   85: 'snow', 86: 'snow',\n94:   95: 'thunderstorm', 96: 'thunderstorm', 99: 'thunderstorm',\n95: };\n96: \n97: /** Chinese labels for WMO codes (used by the Shanghai card). */\n98: const WMO_ZH = {\n99:   0: '晴', 1: '晴', 2: '少云', 3: '多云', 45: '雾', 48: '雾',\n100:   51: '毛毛雨', 53: '毛毛雨', 55: '毛毛雨', 56: '冻雨', 57: '冻雨',\n101:   61: '小雨', 63: '中雨', 65: '大雨', 66: '冻雨', 67: '冻雨',\n102:   71: '小雪', 73: '中雪', 75: '大雪', 77: '雪粒',\n103:   80: '阵雨', 81: '中阵雨', 82: '大雨', 85: '小雪花', 86: '大雪花',\n104:   95: '雷暴', 96: '雷暴', 99: '雷暴',\n105: };\n106: \n107: function codeToCondition(code) {\n108:   const key = WMO_CODE_MAP[code];\n109:   return key && ICONS[key] ? { code: key, ...ICONS[key] } : null;\n110: }\n111: \n112: function round1(n) {\n113:   return Math.round(n * 10) / 10;\n114: }\n115: \n116: function extractTime(observedAt) {\n117:   const m = String(observedAt ?? '').match(/T(\\d{2}:\\d{2})/);\n118:   return m ? m[1] : null;\n119: }\n120: \n121: const WEEKDAY_ZH = ['一', '二', '三', '四', '五', '六', '日'];\n122: \n123: function weekdayOf(dateStr) {\n124:   const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(dateStr ?? ''));\n125:   if (!m) return '';\n126:   return WEEKDAY_ZH[new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])).getDay()];\n127: }\n128: function esc(v) {\n129:   return String(v ?? '').replace(/[&<>\"']/g, (ch) => ({\n130:     '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;'\n131:   }[ch]));\n132: }\n133: \n134: export function unitOf(city) {\n135:   const u = String(city.unit ?? city.tempUnit ?? 'C').replace(/°/g, '').toUpperCase();\n136:   return u === 'F' ? '°F' : '°C';\n137: }\n138: \n139: export function resolveCondition(city) {\n140:   const raw = String(\n141:     city.condition ?? city.icon ?? city.weather?.condition ?? city.weather?.icon ?? 'clear'\n142:   ).toLowerCase().replace(/\\s+/g, '-');\n143:   if (ICONS[raw]) return { code: raw, ...ICONS[raw] };\n144:   for (const rule of KEYWORD_RULES) {\n145:     if (rule.re.test(raw)) return { code: rule.name.code, ...rule.name };\n146:   }\n147:   return { code: 'cloudy', ...FALLBACK };\n148: }\n149: \n150: function themeFor(code) {\n151:   const light = LIGHT.includes(code);\n152:   return {\n153:     text: light ? '#1a202c' : '#f7fafc',\n154:     chip: light ? 'rgba(255, 255, 255, 0.30)' : 'rgba(255, 255, 255, 0.14)',\n155:   };\n156: }\n157: \n158: function statRows(city) {\n159:   const rows = [\n160:     { label: 'Feels like', value: city.feelsLike != null ? `${esc(city.feelsLike)}${unitOf(city)}` : null },\n161:     { label: 'Humidity',   value: city.humidity   != null ? `${esc(city.humidity)}%` : null },\n162:     { label: 'Wind',       value: city.windKmh    != null\n163:       ? `${esc(city.windKmh)} km/h${city.windDirection ? ' ' + esc(city.windDirection) : ''}`\n164:       : null },\n165:     { label: 'Today',      value: city.high != null && city.low != null\n166:       ? `${esc(city.high)}° / ${esc(city.low)}°` : null },\n167:   ];\n168:   return rows\n169:     .filter((r) => r.value != null)\n170:     .map((r) => `<div class=\"wc-stat\"><span class=\"wc-stat-label\">${r.label}</span><span class=\"wc-stat-value\">${r.value}</span></div>`)\n171:     .join('');\n172: }\n173: \n174: function hourlyRow(hourly, unit) {\n175:   if (!Array.isArray(hourly) || hourly.length === 0) return '';\n176:   const items = hourly\n177:     .map((h) => {\n178:       const cond = resolveCondition(h);\n179:       const t = h.temp != null ? `${esc(h.temp)}${unit}` : '';\n180:       return `<div class=\"wc-hour\"><span class=\"wc-hour-time\">${esc(h.time ?? '')}</span><span class=\"wc-hour-icon\" aria-hidden=\"true\">${cond.emoji}</span><span class=\"wc-hour-temp\">${t}</span></div>`;\n181:     })\n182:     .join('');\n183:   return `<div class=\"wc-hourly\" aria-label=\"Hourly forecast\">${items}</div>`;\n184: }\n185: \n186: export function renderWeatherCard(city) {\n187:   const unit = unitOf(city);\n188:   const cond = resolveCondition(city);\n189:   const label = esc(city.description ?? cond.label);\n190:   const theme = themeFor(cond.code);\n191:   const gradient = GRADIENTS[cond.code] ?? GRADIENTS.cloudy;\n192: \n193:   const sub = city.country != null\n194:     ? `<span class=\"wc-sub\">${esc(city.country)}</span>`\n195:     : '';\n196:   const time = city.time != null ? `<span class=\"wc-time\">${esc(city.time)}</span>` : '';\n197: \n198:   const header = `<div class=\"wc-header\"><div class=\"wc-location\"><span class=\"wc-city\">${esc(city.city)}</span>${sub}</div>${time}</div>`;\n199: \n200:   const main = `<div class=\"wc-main\"><span class=\"wc-icon\" aria-hidden=\"true\">${cond.emoji}</span><div class=\"wc-temp\"><span class=\"wc-temp-value\">${esc(city.temp ?? '–')}</span><span class=\"wc-temp-unit\">${unit}</span></div><p class=\"wc-condition\">${label}</p></div>`;\n201: \n202:   const stats = statRows(city);\n203:   const hourlyHtml = hourlyRow(city.hourly, unit);\n204: \n205:   return `<article class=\"wc\" style=\"--wc-bg:${gradient}; --wc-text:${theme.text}; --wc-chip:${theme.chip}\">${header}${main}${stats ? `<div class=\"wc-stats\">${stats}</div>` : ''}${hourlyHtml}</article>`;\n206: }\n207: \n208: export function renderWeatherGrid(cities) {\n209:   const list = Array.isArray(cities) ? cities : [cities];\n210:   return `<div class=\"wc-grid\" role=\"list\">${list.map(renderWeatherCard).join('')}</div>`;\n211: }\n212: \n213: export function renderWeatherGridToElement(container, cities) {\n214:   injectStyles();\n215:   if (container) container.innerHTML = renderWeatherGrid(cities);\n216:   return container;\n217: }\n218: \n219: const CARD_CSS = `\n220: .wc-grid {\n221:   display: grid;\n222:   grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n223:   gap: 16px;\n224: }\n225: .wc {\n226:   position: relative;\n227:   border-radius: 20px;\n228:   background: var(--wc-bg);\n229:   color: var(--wc-text, #1a202c);\n230:   padding: 16px 16px 14px;\n231:   box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);\n232:   transition: transform 0.2s ease, box-shadow 0.2s ease;\n233: }\n234: .wc:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22); }\n235: .wc-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }\n236: .wc-location { display: flex; flex-direction: column; gap: 2px; }\n237: .wc-city { font-size: 1.05rem; font-weight: 700; }\n238: .wc-sub { font-size: 0.8rem; opacity: 0.75; }\n239: .wc-time { font-size: 0.8rem; opacity: 0.8; white-space: nowrap; }\n240: .wc-main { display: flex; align-items: center; gap: 14px; margin: 10px 0 14px; }\n241: .wc-icon { font-size: 3rem; line-height: 1; }\n242: .wc-temp { font-size: 2.9rem; font-weight: 800; line-height: 1; }\n243: .wc-temp-unit { font-size: 1.05rem; font-weight: 600; opacity: 0.85; margin-left: 2px; }\n244: .wc-condition { margin: 0; font-size: 0.95rem; opacity: 0.9; }\n245: .wc-stats {\n246:   display: grid;\n247:   grid-template-columns: repeat(2, 1fr);\n248:   gap: 10px;\n249:   padding: 10px;\n250:   border-radius: 12px;\n251:   background: var(--wc-chip);\n252: }\n253: .wc-stat { display: flex; flex-direction: column; gap: 2px; }\n254: .wc-stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8; }\n255: .wc-stat-value { font-size: 0.95rem; font-weight: 700; }\n256: .wc-hourly { display: flex; gap: 6px; margin-top: 12px; overflow-x: auto; }\n257: .wc-hour {\n258:   flex: 1;\n259:   min-width: 54px;\n260:   text-align: center;\n261:   border-radius: 10px;\n262:   padding: 6px 4px;\n263:   background: var(--wc-chip);\n264:   font-size: 0.78rem;\n265: }\n266: .wc-hour-time { display: block; opacity: 0.8; }\n267: .wc-hour-icon { display: block; font-size: 1.15rem; margin: 2px 0; }\n268: .wc-hour-temp { display: block; font-weight: 700; }\n269: @media (prefers-reduced-motion: reduce) { .wc { transition: none; } }\n270: @media (max-width: 420px) {\n271:   .wc-grid { grid-template-columns: 1fr; }\n272:   .wc-temp { font-size: 2.4rem; }\n273: }\n274: `;\n275: \n276: export function injectStyles() {\n277:   if (typeof document === 'undefined') return;\n278:   if (document.getElementById('weather-card-style')) return;\n279:   const style = document.createElement('style');\n280:   style.id = 'weather-card-style';\n281:   style.textContent = CARD_CSS;\n282:   document.head.appendChild(style);\n283: }\n284: \n285: \nThe above content shows the entire, complete file contents of the requested file.\n"}
